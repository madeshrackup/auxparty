# Server (repo-root .env or Vercel project env). Never commit real keys.
# Local: copy to .env. Production: set these in the host dashboard, not in git.

RESEND_API_KEY=
# Must use a domain verified on THIS Resend API key (auxparty.co.uk, not auxparty.com).
EMAIL_FROM=Aux Party <noreply@auxparty.co.uk>
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=https://xgypeovqxzazhbucguzt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Defaults to SUPABASE_SERVICE_ROLE_KEY. Do not use the dummy local fallback in production.
PLAY_TOKEN_SECRET=

# After schema.sql, also run:
#   supabase/schema-profile.sql
#   supabase/schema-privacy.sql
#   supabase/schema-security.sql

# Production (Vercel / game host):
#   NODE_ENV=production
#   APP_URL=https://auxparty.co.uk
#   CORS_ORIGIN=https://auxparty.co.uk
#   EMAIL_FROM, RESEND_API_KEY, SUPABASE_SERVICE_ROLE_KEY required
# Same-origin /api on Vercel does not need COOKIE_SAMESITE=none.
# Split API on another host: COOKIE_SAMESITE=none (Secure cookies are automatic in production).
